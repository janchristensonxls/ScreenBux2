<Window x:Class="ScreenBux.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenBux.Agent"
        mc:Ignorable="d"
        Title="ScreenBux Agent" Height="580" Width="700"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        StateChanged="MainWindow_StateChanged">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <!-- Today's usage status (filled from code-behind) -->
        <GroupBox Grid.Row="0" x:Name="UsagePanel" Header="Today" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel x:Name="UsageItems" Margin="6"/>
        </GroupBox>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ServiceStatusText" VerticalAlignment="Center" 
                       Text="Status: Unknown" FontWeight="Bold"/>
            <TextBlock x:Name="PolicyNameText" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Text="" FontWeight="Bold"/>
            <TextBlock x:Name="GrantStatusText" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Text="" FontWeight="Bold" Foreground="DarkOrange"/>
        </StackPanel>

        <!-- Not Linked Info / Activity Log -->
        <Grid Grid.Row="2">
            <GroupBox x:Name="NotLinkedPanel" Header="Device Not Linked" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="10" VerticalAlignment="Top"
                           Text="This device is not yet linked to a parent account. Right-click the ScreenBux Agent icon in the notification area and choose 'Link Device...' to link it."/>
            </GroupBox>

            <TabControl x:Name="MainTabs">
                <TabItem x:Name="MessagesTab" Header="Messages">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                            <TextBlock x:Name="MessagesHint" DockPanel.Dock="Left" Foreground="Gray" VerticalAlignment="Center"
                                       Text="Messages from your parent and time warnings appear here."/>
                            <Button DockPanel.Dock="Right" Content="Clear" Padding="12,2" Click="ClearMessages_Click"/>
                        </DockPanel>
                        <ListBox x:Name="MessagesList" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4" Background="#F3F6FA">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="Gray"/>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Activity Log">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" 
                                 TextWrapping="Wrap" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
