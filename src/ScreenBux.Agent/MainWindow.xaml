<Window x:Class="ScreenBux.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenBux.Agent"
        mc:Ignorable="d"
        Title="ScreenBux Agent" Height="580" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Minimized" ShowInTaskbar="False"
        StateChanged="MainWindow_StateChanged">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="ScreenBux Parental Control Agent" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="ServiceStatusText" VerticalAlignment="Center" 
                       Text="Service: Unknown" FontWeight="Bold"/>
            <TextBlock x:Name="PolicyNameText" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Text="" FontWeight="Bold"/>
            <TextBlock x:Name="GrantStatusText" VerticalAlignment="Center" 
                       Margin="15,0,0,0" Text="" FontWeight="Bold" Foreground="DarkOrange"/>
        </StackPanel>

        <!-- Not Linked Info / Activity Log -->
        <Grid Grid.Row="2">
            <GroupBox x:Name="NotLinkedPanel" Header="Device Not Linked" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="10" VerticalAlignment="Top"
                           Text="This device is not yet linked to a parent account. Right-click the ScreenBux Agent icon in the notification area and choose 'Link Device...' to link it."/>
            </GroupBox>

            <GroupBox x:Name="LogPanel" Header="Activity Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" 
                             TextWrapping="Wrap" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
