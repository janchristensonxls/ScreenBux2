@using ScreenBux.Shared.Models
@using static ScreenBux.WebClient.Components.PolicyEditor.PolicyEditorHelpers

@* "Who is in which mode" - switching modes per child happens here, never in the mode editor below. *@
<div class="pe-assign mb-3">
    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
        <h5 class="mb-0 me-auto">Children</h5>
        <span class="small text-muted">Set everyone to</span>
        <select class="form-select form-select-sm w-auto" @bind="_everyoneProfileId">
            <option value="">Choose mode…</option>
            @foreach (var p in Profiles)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(!Guid.TryParse(_everyoneProfileId, out _) || Busy)"
                @onclick="SetEveryoneAsync">Apply</button>
    </div>

    <div class="pe-assign-cards">
        @foreach (var child in Assignments.Children)
        {
            var used = UsageByChild.TryGetValue(child.ChildProfileId, out var s) ? s : (long?)null;
            <div class="pe-assign-card">
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fw-semibold">@child.DisplayName</span>
                    <span class="small text-muted ms-auto">
                        @child.DeviceCount device@(child.DeviceCount == 1 ? "" : "s")@(used is long u ? $" · {FormatMinutes((int)(u / 60))} today" : "")
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-1 mt-2">
                    @foreach (var p in Profiles)
                    {
                        var current = p.Id == child.EffectiveProfileId;
                        <button type="button" class="btn btn-sm @(current ? "btn-primary" : "btn-outline-secondary")" disabled="@Busy"
                                title="@(current ? $"{child.DisplayName} is in {p.Name}" : $"Switch {child.DisplayName} to {p.Name}")"
                                @onclick="() => OnActivate.InvokeAsync((p.Id, child.ChildProfileId))">@p.Name</button>
                    }
                </div>
                <div class="d-flex align-items-center mt-1">
                    @if (child.AssignedProfileId is null)
                    {
                        <span class="small text-muted">Follows the default mode</span>
                    }
                    <button type="button" class="btn btn-sm btn-link ms-auto px-0" disabled="@(child.DeviceCount == 0)"
                            title="@(child.DeviceCount == 0 ? "No devices linked" : $"Send a pop-up message to {child.DisplayName}")"
                            @onclick="() => ToggleMessage(child.ChildProfileId)">
                        @(_messageOpenFor.Contains(child.ChildProfileId) ? "Close" : "✉ Message")
                    </button>
                </div>
                @if (_messageOpenFor.Contains(child.ChildProfileId))
                {
                    <SendMessageBox ChildProfileId="child.ChildProfileId" ChildName="@child.DisplayName" />
                }
            </div>
        }

        <div class="pe-assign-card pe-assign-default">
            <div class="d-flex align-items-baseline gap-2">
                <span class="fw-semibold">Default mode</span>
                <span class="small text-muted ms-auto">@Assignments.UnassignedDeviceCount unassigned device@(Assignments.UnassignedDeviceCount == 1 ? "" : "s")</span>
            </div>
            <select class="form-select form-select-sm mt-2" value="@Assignments.DefaultProfileId" disabled="@Busy"
                    @onchange="e => OnActivate.InvokeAsync((Guid.Parse((string)e.Value!), (Guid?)null))">
                @foreach (var p in Profiles)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <div class="small text-muted mt-1">Used by devices not linked to a child, and by children that follow the default.</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PolicyProfileDto> Profiles { get; set; } = Array.Empty<PolicyProfileDto>();
    [Parameter, EditorRequired] public PolicyAssignmentsDto Assignments { get; set; } = new();
    [Parameter] public IReadOnlyDictionary<Guid, long> UsageByChild { get; set; } = new Dictionary<Guid, long>();
    [Parameter] public bool Busy { get; set; }

    /// <summary>(mode id, child id or null for the account default)</summary>
    [Parameter] public EventCallback<(Guid ProfileId, Guid? ChildProfileId)> OnActivate { get; set; }

    [Parameter] public EventCallback<Guid> OnActivateAll { get; set; }

    private string _everyoneProfileId = string.Empty;
    private readonly HashSet<Guid> _messageOpenFor = new();

    private void ToggleMessage(Guid childId)
    {
        if (!_messageOpenFor.Remove(childId))
        {
            _messageOpenFor.Add(childId);
        }
    }

    private async Task SetEveryoneAsync()
    {
        if (Guid.TryParse(_everyoneProfileId, out var id))
        {
            await OnActivateAll.InvokeAsync(id);
            _everyoneProfileId = string.Empty;
        }
    }
}
