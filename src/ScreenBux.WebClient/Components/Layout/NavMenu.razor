<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ScreenBux Control Panel</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="monitoring">
                <span class="bi bi-activity-nav-menu" aria-hidden="true"></span> Monitoring
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="policy">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Policy
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="link-device">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Link a device
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <span class="nav-link">Signed in as @context.User.Identity?.Name</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Sign in
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
