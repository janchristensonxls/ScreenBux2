<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Recent Activity</h5>
        @if (_processHistory.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Process Name</th>
                            <th>PID</th>
                            <th>Window Title</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var process in _processHistory.Take(20))
                        {
                            <tr>
                                <td>@process.DetectedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>@process.ProcessName</td>
                                <td>@process.ProcessId</td>
                                <td>@process.WindowTitle</td>
                                <td>
                                    <button class="btn btn-sm btn-warning" @onclick="() => CloseProcess(process.ProcessId)">
                                        Close
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No activity detected yet.</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Device Actions</h5>
        <div class="mb-3">
            <label class="form-label">Select a device</label>
            <select class="form-select" style="max-width: 300px;" @bind="_selectedDeviceId">
                <option value="">-- Select a device --</option>
                @foreach (var device in _devices)
                {
                    <option value="@device.Id">@device.Name</option>
                }
            </select>
        </div>

        @if (!_isConnected)
        {
            <p class="text-warning">Connect to the monitoring service (above) to use device actions.</p>
        }

        <div class="row">
            <div class="col-md-6 border-md-end">
                <h6>Process List</h6>
                <button class="btn btn-primary mb-2" @onclick="RequestProcessList" disabled="@(!_isConnected || _isRequestingProcessList || string.IsNullOrEmpty(_selectedDeviceId))">
                    @(_isRequestingProcessList ? "Requesting..." : "Get Process List")
                </button>

                @if (_processListError is not null)
                {
                    <p class="text-danger">@_processListError</p>
                }
            </div>

            <div class="col-md-6">
                <h6>Screen Capture</h6>
                <button class="btn btn-primary mb-2" @onclick="RequestScreenCapture" disabled="@(!_isConnected || _isRequestingScreenCapture || string.IsNullOrEmpty(_selectedDeviceId))">
                    @(_isRequestingScreenCapture ? "Capturing..." : "Capture Screens")
                </button>

                @if (_screenCaptureError is not null)
                {
                    <p class="text-danger">@_screenCaptureError</p>
                }
            </div>
        </div>

        @if (_currentProcessList is not null)
        {
            <hr />
            <h6>Process List Result</h6>
            <p class="text-muted">Retrieved @_currentProcessList.Count at @_processListRetrievedAt?.ToLocalTime().ToString("HH:mm:ss")</p>
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>PID</th>
                            <th>Name</th>
                            <th>Executable Path</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var process in _currentProcessList)
                        {
                            <tr>
                                <td>@process.ProcessId</td>
                                <td>@process.ProcessName</td>
                                <td>@process.ExecutablePath</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_screenCaptureImages.Any())
        {
            <hr />
            <h6>Screen Capture Result</h6>
            <div class="d-flex flex-column gap-2">
                @for (var i = 0; i < _screenCaptureImages.Count; i++)
                {
                    var index = i;
                    <img src="@_screenCaptureImages[index]"
                         class="w-100"
                         style="cursor: pointer; border: 1px solid #ccc;"
                         @onclick="() => OpenScreenCaptureViewer(index)" />
                }
            </div>
        }
    </div>
</div>

@if (_viewerImageIndex is not null)
{
    <div style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.85); z-index: 1050; display: flex; align-items: center; justify-content: center; cursor: zoom-out;"
         @onclick="CloseScreenCaptureViewer">
        <img src="@_screenCaptureImages[_viewerImageIndex.Value]" style="max-width: 95vw; max-height: 95vh;" />
    </div>
}

