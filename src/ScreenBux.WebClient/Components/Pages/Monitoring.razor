@code {
    private static readonly TimeSpan ProcessListTimeout = TimeSpan.FromSeconds(15);

    private bool _isConnected = false;
    private List<ProcessInfo> _processHistory = new();
    private List<string> _statusMessages = new();
    private List<DeviceDto> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private bool _isRequestingProcessList = false;
    private string? _processListError;
    private List<ProcessInfo>? _currentProcessList;
    private DateTime? _processListRetrievedAt;
    private Guid? _pendingProcessListRequestId;
    private CancellationTokenSource? _processListTimeoutCts;

    private static readonly TimeSpan ScreenCaptureTimeout = TimeSpan.FromSeconds(20);
    private bool _isRequestingScreenCapture = false;
    private string? _screenCaptureError;
    private List<string> _screenCaptureImages = new();
    private Guid? _pendingScreenCaptureRequestId;
    private CancellationTokenSource? _screenCaptureTimeoutCts;
    private int? _viewerImageIndex;

    protected override async Task OnInitializedAsync()
    {
        MonitoringService.ProcessDetected += OnProcessDetected;
        MonitoringService.PolicyUpdated += OnPolicyUpdated;
        MonitoringService.StatusReceived += OnStatusReceived;
        MonitoringService.ProcessListReceived += OnProcessListReceived;
        MonitoringService.ScreenCaptureReady += OnScreenCaptureReady;

        try
        {
            var devices = await DevicesApiService.ListDevicesAsync();
            _devices = devices.ToList();
        }
        catch (Exception ex)
        {
            AddStatusMessage($"Error loading devices: {ex.Message}");
        }

        await Connect();
    }

    private async Task Connect()
    {
        try
        {
            await MonitoringService.StartAsync();
            _isConnected = MonitoringService.IsConnected;
            AddStatusMessage("Connected to monitoring service");
        }
        catch (Exception ex)
        {
            AddStatusMessage($"Error connecting: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        try
        {
            await MonitoringService.StopAsync();
            _isConnected = MonitoringService.IsConnected;
            AddStatusMessage("Disconnected from monitoring service");
        }
        catch (Exception ex)
        {
            AddStatusMessage($"Error disconnecting: {ex.Message}");
        }
        StateHasChanged();
    }

    // private async Task RequestStatus()
    // {
    //     await MonitoringService.RequestStatusAsync();
    //     AddStatusMessage("Status request sent");
    // }

    private async Task CloseProcess(int processId)
    {
        await MonitoringService.CloseProcessAsync(processId);
        AddStatusMessage($"Close request sent for process {processId}");
    }

    private async Task RequestProcessList()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId))
        {
            return;
        }

        _processListTimeoutCts?.Cancel();
        _processListTimeoutCts = new CancellationTokenSource();
        var timeoutToken = _processListTimeoutCts.Token;

        _isRequestingProcessList = true;
        _processListError = null;
        _currentProcessList = null;
        StateHasChanged();

        try
        {
            _pendingProcessListRequestId = await MonitoringService.RequestProcessListAsync(deviceId);
            AddStatusMessage($"Process list requested for device {deviceId}");

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(ProcessListTimeout, timeoutToken);
                    await InvokeAsync(() =>
                    {
                        if (_isRequestingProcessList)
                        {
                            _isRequestingProcessList = false;
                            _processListError = "Device did not respond in time.";
                            StateHasChanged();
                        }
                    });
                }
                catch (TaskCanceledException)
                {
                    // Response arrived before the timeout elapsed; nothing to do.
                }
            }, timeoutToken);
        }
        catch (Exception ex)
        {
            _isRequestingProcessList = false;
            _processListError = $"Error requesting process list: {ex.Message}";
        }

        StateHasChanged();
    }

    private void OnProcessDetected(object? sender, ProcessInfo processInfo)
    {
        _processHistory.Insert(0, processInfo);
        AddStatusMessage($"Process detected: {processInfo.ProcessName} (PID: {processInfo.ProcessId})");
        InvokeAsync(StateHasChanged);
    }

    private void OnPolicyUpdated(object? sender, PolicyConfiguration config)
    {
        AddStatusMessage("Policy configuration updated");
        InvokeAsync(StateHasChanged);
    }

    private void OnStatusReceived(object? sender, string status)
    {
        AddStatusMessage($"Status: {status}");
        InvokeAsync(StateHasChanged);
    }

    private void OnProcessListReceived(object? sender, ProcessListResult result)
    {
        if (_pendingProcessListRequestId != result.RequestId)
        {
            // Stale/unexpected result (e.g. a previous request that already timed out); ignore.
            return;
        }

        _processListTimeoutCts?.Cancel();
        _isRequestingProcessList = false;

        if (result.Success)
        {
            _currentProcessList = result.Processes;
            _processListRetrievedAt = DateTime.UtcNow;
            _processListError = null;
            AddStatusMessage($"Process list received for device {result.DeviceId} ({result.Processes.Count} processes)");
        }
        else
        {
            _processListError = result.ErrorMessage ?? "Failed to retrieve process list.";
            AddStatusMessage($"Process list request failed for device {result.DeviceId}: {_processListError}");
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task RequestScreenCapture()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId))
        {
            return;
        }

        _screenCaptureTimeoutCts?.Cancel();
        _screenCaptureTimeoutCts = new CancellationTokenSource();
        var timeoutToken = _screenCaptureTimeoutCts.Token;

        _isRequestingScreenCapture = true;
        _screenCaptureError = null;
        _screenCaptureImages = new();
        _viewerImageIndex = null;
        StateHasChanged();

        try
        {
            _pendingScreenCaptureRequestId = await MonitoringService.RequestScreenCaptureAsync(deviceId);
            AddStatusMessage($"Screen capture requested for device {deviceId}");

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(ScreenCaptureTimeout, timeoutToken);
                    await InvokeAsync(() =>
                    {
                        if (_isRequestingScreenCapture)
                        {
                            _isRequestingScreenCapture = false;
                            _screenCaptureError = "Device did not respond in time.";
                            StateHasChanged();
                        }
                    });
                }
                catch (TaskCanceledException)
                {
                    // Response arrived before the timeout elapsed; nothing to do.
                }
            }, timeoutToken);
        }
        catch (Exception ex)
        {
            _isRequestingScreenCapture = false;
            _screenCaptureError = $"Error requesting screen capture: {ex.Message}";
        }

        StateHasChanged();
    }

    private async void OnScreenCaptureReady(object? sender, (Guid RequestId, int ImageCount) ready)
    {
        if (_pendingScreenCaptureRequestId != ready.RequestId)
        {
            // Stale/unexpected result (e.g. a previous request that already timed out); ignore.
            return;
        }

        _screenCaptureTimeoutCts?.Cancel();

        try
        {
            var images = new List<string>();
            for (var index = 0; index < ready.ImageCount; index++)
            {
                var bytes = await ScreenCaptureApiService.DownloadImageAsync(ready.RequestId, index);
                images.Add($"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}");
            }

            await InvokeAsync(() =>
            {
                _isRequestingScreenCapture = false;
                _screenCaptureImages = images;
                _screenCaptureError = null;
                AddStatusMessage($"Screen capture received ({ready.ImageCount} images)");
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _isRequestingScreenCapture = false;
                _screenCaptureError = $"Error downloading screen capture: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private void OpenScreenCaptureViewer(int index)
    {
        _viewerImageIndex = index;
    }

    private void CloseScreenCaptureViewer()
    {
        _viewerImageIndex = null;
    }

    private void AddStatusMessage(string message)
    {
        var timestamp = DateTime.Now.ToString("HH:mm:ss");
        _statusMessages.Insert(0, $"[{timestamp}] {message}");
        if (_statusMessages.Count > 50)
        {
            _statusMessages.RemoveAt(_statusMessages.Count - 1);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _processListTimeoutCts?.Cancel();
        _screenCaptureTimeoutCts?.Cancel();
        MonitoringService.ProcessDetected -= OnProcessDetected;
        MonitoringService.PolicyUpdated -= OnPolicyUpdated;
        MonitoringService.StatusReceived -= OnStatusReceived;
        MonitoringService.ProcessListReceived -= OnProcessListReceived;
        MonitoringService.ScreenCaptureReady -= OnScreenCaptureReady;
    }
}
