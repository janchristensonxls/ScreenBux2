@page "/"
@using ScreenBux.WebClient.Services
@inject DevicesApiService DevicesApiService
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_checking)
        {
            <p><em>Loading...</em></p>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Welcome to ScreenBux</h1>
        <p>
            <a href="login">Log in / create account</a>
        </p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _checking = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var devices = await DevicesApiService.ListDevicesAsync();
            Navigation.NavigateTo(devices.Count == 0 ? "link-device" : "monitoring");
        }
        catch
        {
            // Not authenticated or the request failed; NotAuthorized view (or a retry) handles it.

            Navigation.NavigateTo("login");
        }
        finally
        {
            _checking = false;
        }
    }
}
