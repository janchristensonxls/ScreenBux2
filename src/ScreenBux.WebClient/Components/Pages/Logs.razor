@page "/logs"
@attribute [Authorize]
@using ScreenBux.Shared.Models
@using ScreenBux.Shared.Models.Devices
@using ScreenBux.WebClient.Services
@inject MonitoringService MonitoringService
@inject DevicesApiService DevicesApiService
@inject UsageLogsApiService UsageLogsApiService
@implements IAsyncDisposable

<PageTitle>Logs</PageTitle>

<h1>Usage Logs</h1>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Fetch a device's activity log</h5>
        <p class="text-muted">
            Pulls the device's local day-by-day activity log (foreground app/window segments) for
            the selected date range. The device must be online to respond.
        </p>

        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Device</label>
                <select class="form-select" @bind="_selectedDeviceId">
                    <option value="">-- Select a device --</option>
                    @foreach (var device in _devices)
                    {
                        <option value="@device.Id">@device.Name</option>
                    }
                </select>
            </div>

            <div class="col-auto">
                <label class="form-label">From</label>
                <input type="date" class="form-control" value="@_startDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged" />
            </div>

            <div class="col-auto">
                <label class="form-label">To</label>
                <input type="date" class="form-control" value="@_endDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged" />
            </div>

            <div class="col-auto">
                <button class="btn btn-primary" @onclick="FetchLogsAsync" disabled="@(!MonitoringService.IsConnected || _isFetching || string.IsNullOrEmpty(_selectedDeviceId))">
                    @(_isFetching ? "Fetching..." : "Fetch Logs")
                </button>
            </div>
        </div>

        @if (!MonitoringService.IsConnected)
        {
            <p class="text-warning mt-2">Not connected to the monitoring service.</p>
        }

        @if (_fetchError is not null)
        {
            <p class="text-danger mt-2">@_fetchError</p>
        }
    </div>
</div>

@if (_hasFetched && !_isFetching)
{
    @if (!_days.Any())
    {
        <p class="text-muted">No activity logged for this device in the selected range.</p>
    }
    else
    {
        @foreach (var day in _days.OrderByDescending(d => d.EffectiveDate))
        {
            var dayTotalSeconds = day.Entries.Sum(e => e.DurationSeconds);
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title d-flex justify-content-between">
                        <span>@day.EffectiveDate.ToString("dddd, MMM d yyyy")</span>
                        <span class="text-muted">@FormatDuration(dayTotalSeconds) logged</span>
                    </h5>

                    @if (!day.Entries.Any())
                    {
                        <p class="text-muted">No activity logged.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Duration</th>
                                        <th>Category</th>
                                        <th>Process</th>
                                        <th>Window Title</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in day.Entries.OrderBy(e => e.StartedAt))
                                    {
                                        <tr>
                                            <td>@entry.StartedAt.ToString("HH:mm:ss")</td>
                                            <td>@entry.EndedAt.ToString("HH:mm:ss")</td>
                                            <td>@FormatDuration(entry.DurationSeconds)</td>
                                            <td>@entry.CategoryName</td>
                                            <td>@entry.ProcessName</td>
                                            <td>@entry.WindowTitle</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    private static readonly TimeSpan FetchTimeout = TimeSpan.FromSeconds(20);

    private List<DeviceDto> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-6));
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.Today);

    private bool _isFetching;
    private bool _hasFetched;
    private string? _fetchError;
    private List<UsageDayLog> _days = new();
    private Guid? _pendingRequestId;
    private CancellationTokenSource? _fetchTimeoutCts;

    protected override async Task OnInitializedAsync()
    {
        MonitoringService.UsageLogsReady += OnUsageLogsReady;

        try
        {
            var devices = await DevicesApiService.ListDevicesAsync();
            _devices = devices.ToList();
            if (_devices.Count == 1)
            {
                _selectedDeviceId = _devices[0].Id.ToString();
            }
        }
        catch
        {
            // Best-effort; the device selector just stays empty.
        }

        if (!MonitoringService.IsConnected)
        {
            try
            {
                await MonitoringService.StartAsync();
            }
            catch
            {
                // Best-effort; the "not connected" warning above covers this.
            }
        }
    }

    private void OnStartDateChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var date))
        {
            _startDate = date;
        }
    }

    private void OnEndDateChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var date))
        {
            _endDate = date;
        }
    }

    private async Task FetchLogsAsync()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId))
        {
            return;
        }

        var startDate = _startDate;
        var endDate = _endDate;
        if (endDate < startDate)
        {
            (startDate, endDate) = (endDate, startDate);
        }

        _fetchTimeoutCts?.Cancel();
        _fetchTimeoutCts = new CancellationTokenSource();
        var timeoutToken = _fetchTimeoutCts.Token;

        _isFetching = true;
        _hasFetched = false;
        _fetchError = null;
        _days = new();
        StateHasChanged();

        try
        {
            _pendingRequestId = await MonitoringService.RequestUsageLogsAsync(deviceId, startDate, endDate);

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(FetchTimeout, timeoutToken);
                    await InvokeAsync(() =>
                    {
                        if (_isFetching)
                        {
                            _isFetching = false;
                            _fetchError = "Device did not respond in time.";
                            StateHasChanged();
                        }
                    });
                }
                catch (TaskCanceledException)
                {
                    // Response arrived before the timeout elapsed; nothing to do.
                }
            }, timeoutToken);
        }
        catch (Exception ex)
        {
            _isFetching = false;
            _fetchError = $"Error requesting usage logs: {ex.Message}";
        }

        StateHasChanged();
    }

    private async void OnUsageLogsReady(object? sender, (Guid RequestId, int DayCount) ready)
    {
        if (_pendingRequestId != ready.RequestId)
        {
            // Stale/unexpected result (e.g. a previous request that already timed out); ignore.
            return;
        }

        _fetchTimeoutCts?.Cancel();

        try
        {
            var days = await UsageLogsApiService.GetAsync(ready.RequestId);

            await InvokeAsync(() =>
            {
                _isFetching = false;
                _hasFetched = true;
                _days = days.ToList();
                _fetchError = null;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _isFetching = false;
                _hasFetched = true;
                _fetchError = $"Error downloading usage logs: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private static string FormatDuration(long seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}h {ts.Minutes}m"
            : $"{ts.Minutes}m {ts.Seconds}s";
    }

    public async ValueTask DisposeAsync()
    {
        _fetchTimeoutCts?.Cancel();
        MonitoringService.UsageLogsReady -= OnUsageLogsReady;
        await Task.CompletedTask;
    }
}
