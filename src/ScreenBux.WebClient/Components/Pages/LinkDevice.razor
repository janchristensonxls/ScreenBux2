@page "/link-device"
@attribute [Authorize]
@implements IDisposable
@inject DevicesApiService DevicesApi
@inject GrantApiService GrantApi

<PageTitle>Link a device</PageTitle>

<h1>Link a device</h1>

<p>Generate a code, then enter it on the device you want to control. The code expires shortly.</p>

<button class="btn btn-primary" @onclick="GenerateAsync" disabled="@_busy">Generate link code</button>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@if (_code is not null)
{
    <div class="alert alert-success mt-3">
        <div>Enter this code on the device:</div>
        <h2 class="mt-2"><code>@_code.Code</code></h2>
        <div class="text-muted">Expires at @_code.ExpiresAt.ToLocalTime().ToString("t")</div>
    </div>
}

<h2 class="mt-4">Linked devices</h2>

@if (_devices is null)
{
    <p><em>Loading…</em></p>
}
else if (_devices.Count == 0)
{
    <p>No devices linked yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Linked</th><th>Last seen</th><th>Bonus time</th></tr>
        </thead>
        <tbody>
            @foreach (var device in _devices)
            {
                <tr>
                    <td>@device.Name</td>
                    <td>@device.LinkedAt.ToLocalTime().ToString("g")</td>
                    <td>@(device.LastSeenAt?.ToLocalTime().ToString("g") ?? "—")</td>
                    <td>
                        @{
                            var remaining = GetRemaining(device.Id);
                        }
                        @if (remaining is TimeSpan ts)
                        {
                            <span class="badge bg-warning text-dark me-2">@ts.ToString(@"hh\:mm\:ss")</span>
                        }
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" @onclick="() => AddMinutesAsync(device.Id, 15)">+15m</button>
                            <button class="btn btn-outline-secondary" @onclick="() => AddMinutesAsync(device.Id, 30)">+30m</button>
                            <button class="btn btn-outline-danger" @onclick="() => ClearGrantAsync(device.Id)">Clear</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ScreenBux.Shared.Models.Devices.LinkCodeResponse? _code;
    private List<ScreenBux.Shared.Models.Devices.DeviceDto>? _devices;
    private readonly Dictionary<Guid, DateTime?> _grantExpiries = new();
    private System.Threading.Timer? _countdownTimer;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDevicesAsync();
        await RefreshGrantsAsync();

        _countdownTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshGrantsAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private TimeSpan? GetRemaining(Guid deviceId)
    {
        if (_grantExpiries.TryGetValue(deviceId, out var expiresAtUtc) && expiresAtUtc is DateTime expires && expires > DateTime.UtcNow)
        {
            return expires - DateTime.UtcNow;
        }

        return null;
    }

    private async Task RefreshGrantsAsync()
    {
        if (_devices is null)
        {
            return;
        }

        foreach (var device in _devices)
        {
            try
            {
                var grant = await GrantApi.GetGrantAsync(device.Id);
                _grantExpiries[device.Id] = grant?.ExpiresAtUtc;
            }
            catch
            {
                // Best-effort; keep previous value on transient failure.
            }
        }
    }

    private async Task AddMinutesAsync(Guid deviceId, int minutes)
    {
        try
        {
            var grant = await GrantApi.AddMinutesAsync(deviceId, minutes);
            _grantExpiries[deviceId] = grant?.ExpiresAtUtc;
        }
        catch (Exception ex)
        {
            _error = $"Could not adjust bonus time: {ex.Message}";
        }
    }

    private async Task ClearGrantAsync(Guid deviceId)
    {
        try
        {
            var grant = await GrantApi.ClearGrantAsync(deviceId);
            _grantExpiries[deviceId] = grant?.ExpiresAtUtc;
        }
        catch (Exception ex)
        {
            _error = $"Could not clear bonus time: {ex.Message}";
        }
    }

    private async Task GenerateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _code = await DevicesApi.GenerateLinkCodeAsync();
            await RefreshDevicesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not generate a code: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshDevicesAsync()
    {
        try
        {
            _devices = (await DevicesApi.ListDevicesAsync()).ToList();
            await RefreshGrantsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load devices: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}
