@page "/link-device"
@attribute [Authorize]
@implements IDisposable
@inject DevicesApiService DevicesApi
@inject ChildProfilesApiService ChildProfilesApi
@inject GrantApiService GrantApi

<PageTitle>Link a device</PageTitle>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Children</h5>
        <p>Create a child profile before linking a device to it.</p>

        <div class="input-group mb-3" style="max-width: 400px;">
            <input class="form-control" placeholder="Child's name" @bind="_newChildName" @bind:event="oninput" />
            <button class="btn btn-primary" @onclick="CreateChildAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newChildName))">Add child</button>
        </div>

        @if (_children is null)
        {
            <p><em>Loading…</em></p>
        }
        else if (_children.Count == 0)
        {
            <p>No children yet. Add one above before linking a device.</p>
        }
        else
        {
            <ul class="list-group mb-4" style="max-width: 400px;">
                @foreach (var child in _children)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @child.DisplayName
                        <span class="badge bg-secondary rounded-pill">@child.DeviceCount device(s)</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Link a device</h5>
        <p>Pick a child, generate a code, then enter it on the device you want to control. The code expires shortly.</p>

        <div class="row" style="max-width: 500px;">
            <div class="col-auto">
                <select class="form-select" @bind="_selectedChildId">
                    <option value="">Select a child…</option>
                    @if (_children is not null)
                    {
                        @foreach (var child in _children)
                        {
                            <option value="@child.Id">@child.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_selectedChildId) || _children is null || _children.Count == 0)">Generate link code</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        @if (_code is not null)
        {
            <div class="alert alert-success mt-3">
                <div>Enter this code on the device:</div>
                <h2 class="mt-2"><code>@_code.Code</code></h2>
                <div class="text-muted">Expires at @_code.ExpiresAt.ToLocalTime().ToString("t")</div>
            </div>
        }
    </div>
</div>



<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">>Linked devices</h5>
        @if (_devices is null)
        {
            <p><em>Loading…</em></p>
        }
        else if (_devices.Count == 0)
        {
            <p>No devices linked yet.</p>
        }
        else
        {
            @foreach (var group in _devices.GroupBy(d => d.ChildProfileName ?? "Unassigned").OrderBy(g => g.Key))
            {
                <h3 class="mt-3">@group.Key</h3>
                <table class="table">
                    <thead>
                        <tr><th>Name</th><th>Linked</th><th>Last seen</th><th>Bonus time</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var device in group)
                        {
                            <tr>
                                <td>@device.Name</td>
                                <td>@device.LinkedAt.ToLocalTime().ToString("g")</td>
                                <td>@(device.LastSeenAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td>
                                    @{
                                        var remaining = GetRemaining(device.Id);
                                    }
                                    @if (remaining is TimeSpan ts)
                                    {
                                        <span class="badge bg-warning text-dark me-2">@ts.ToString(@"hh\:mm\:ss")</span>
                                    }
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" @onclick="() => AddMinutesAsync(device.Id, 15)">+15m</button>
                                        <button class="btn btn-outline-secondary" @onclick="() => AddMinutesAsync(device.Id, 30)">+30m</button>
                                        <button class="btn btn-outline-danger" @onclick="() => ClearGrantAsync(device.Id)">Clear</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>




@code {
    private ScreenBux.Shared.Models.Devices.LinkCodeResponse? _code;
    private List<ScreenBux.Shared.Models.Devices.DeviceDto>? _devices;
    private List<ScreenBux.Shared.Models.Devices.ChildProfileDto>? _children;
    private readonly Dictionary<Guid, DateTime?> _grantExpiries = new();
    private System.Threading.Timer? _countdownTimer;
    private bool _busy;
    private string? _error;
    private string _newChildName = string.Empty;
    private string _selectedChildId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshChildrenAsync();
        await RefreshDevicesAsync();
        await RefreshGrantsAsync();

        _countdownTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshGrantsAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshChildrenAsync()
    {
        try
        {
            _children = (await ChildProfilesApi.ListProfilesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = $"Could not load children: {ex.Message}";
        }
    }

    private async Task CreateChildAsync()
    {
        if (string.IsNullOrWhiteSpace(_newChildName))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await ChildProfilesApi.CreateProfileAsync(_newChildName.Trim());
            _newChildName = string.Empty;
            await RefreshChildrenAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not create child: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private TimeSpan? GetRemaining(Guid deviceId)
    {
        if (_grantExpiries.TryGetValue(deviceId, out var expiresAtUtc) && expiresAtUtc is DateTime expires && expires > DateTime.UtcNow)
        {
            return expires - DateTime.UtcNow;
        }

        return null;
    }

    private async Task RefreshGrantsAsync()
    {
        if (_devices is null)
        {
            return;
        }

        foreach (var device in _devices)
        {
            try
            {
                var grant = await GrantApi.GetGrantAsync(device.Id);
                _grantExpiries[device.Id] = grant?.ExpiresAtUtc;
            }
            catch
            {
                // Best-effort; keep previous value on transient failure.
            }
        }
    }

    private async Task AddMinutesAsync(Guid deviceId, int minutes)
    {
        try
        {
            var grant = await GrantApi.AddMinutesAsync(deviceId, minutes);
            _grantExpiries[deviceId] = grant?.ExpiresAtUtc;
        }
        catch (Exception ex)
        {
            _error = $"Could not adjust bonus time: {ex.Message}";
        }
    }

    private async Task ClearGrantAsync(Guid deviceId)
    {
        try
        {
            var grant = await GrantApi.ClearGrantAsync(deviceId);
            _grantExpiries[deviceId] = grant?.ExpiresAtUtc;
        }
        catch (Exception ex)
        {
            _error = $"Could not clear bonus time: {ex.Message}";
        }
    }

    private async Task GenerateAsync()
    {
        if (!Guid.TryParse(_selectedChildId, out var childId))
        {
            _error = "Select a child first.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _code = await DevicesApi.GenerateLinkCodeAsync(childId);
            await RefreshDevicesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not generate a code: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshDevicesAsync()
    {
        try
        {
            _devices = (await DevicesApi.ListDevicesAsync()).ToList();
            await RefreshGrantsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load devices: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}

