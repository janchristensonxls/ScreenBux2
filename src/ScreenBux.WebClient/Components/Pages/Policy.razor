@page "/policy"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@using ScreenBux.Shared.Models
@using ScreenBux.Shared.Utilities
@using ScreenBux.WebClient.Components.PolicyEditor
@inject ScreenBux.WebClient.Services.PolicyApiService PolicyApiService
@inject IJSRuntime JS

<PageTitle>Policy</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="mb-0">Policy Editor</h1>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_statusIsError ? "alert-danger" : "alert-info") alert-dismissible py-2">
        @_statusMessage
        <button type="button" class="btn-close" @onclick="() => _statusMessage = string.Empty"></button>
    </div>
}

<div class="row g-3">
    <!-- Mode / profile list -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header fw-semibold">Modes</div>
            <div class="list-group list-group-flush">
                @if (_profiles.Count == 0)
                {
                    <div class="list-group-item text-muted">@(_loading ? "Loading…" : "No modes yet.")</div>
                }
                @foreach (var profile in _profiles)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center @(profile.Id == _selected?.Id ? "active" : "")"
                            @onclick="() => SelectProfileAsync(profile)">
                        <span class="flex-grow-1">@profile.Name</span>
                        @if (profile.IsActive)
                        {
                            <span class="badge bg-success ms-1" title="Currently applied to devices">active</span>
                        }
                        @if (profile.IsBuiltIn)
                        {
                            <span class="badge bg-secondary ms-1">built-in</span>
                        }
                    </button>
                }
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-success w-100" disabled="@(_selected is null || _selected.IsActive)"
                        title="@(_selected?.IsActive == true ? "This mode is already active" : "Apply the selected mode to all devices")"
                        @onclick="ActivateAsync">@(_selected?.IsActive == true ? "Active mode" : "Activate")</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NewProfileAsync">New</button>
                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_selected is null)" @onclick="DuplicateProfileAsync">Duplicate</button>
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_selected is null || _selected.IsActive || _selected.IsBuiltIn)"
                        title="The active mode cannot be deleted" @onclick="DeleteProfileAsync">Delete</button>
            </div>
        </div>
    </div>

    <!-- Editor -->
    <div class="col-lg-9">
        @if (_selected is not null && _policy is not null)
        {
            var issues = PolicyEditorHelpers.Validate(_policy);
            var errors = issues.Count(i => i.Severity == PolicyIssueSeverity.Error);

            <div class="card mb-3">
                <div class="card-body d-flex align-items-center flex-wrap gap-2">
                    <DxTextBox Text="@_name" TextChanged="(string v) => _name = v" Width="240px" NullText="Mode name" ReadOnly="_selected.IsBuiltIn" />
                    @if (IsDirty)
                    {
                        <span class="badge bg-warning text-dark">unsaved changes</span>
                    }
                    <div class="ms-auto d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" disabled="@(!IsDirty)" @onclick="Revert">Revert</button>
                        <button type="button" class="btn btn-primary" disabled="@(!IsDirty || errors > 0 || _saving)" @onclick="SaveAsync"
                                title="@(errors > 0 ? "Fix errors before saving" : "")">
                            @(_saving ? "Saving…" : _selected.IsActive ? "Save & push to devices" : "Save")
                        </button>
                    </div>
                </div>
                @if (issues.Count > 0)
                {
                    <div class="card-footer py-2">
                        @foreach (var issue in issues)
                        {
                            <div class="small @(issue.Severity == PolicyIssueSeverity.Error ? "text-danger" : "text-warning-emphasis")">
                                @(issue.Severity == PolicyIssueSeverity.Error ? "✖" : "⚠") <strong>@issue.Area:</strong> @issue.Message
                            </div>
                        }
                    </div>
                }
            </div>

            <DxTabs ActiveTabIndex="_tabIndex" ActiveTabIndexChanged="OnTabChanged">
                <DxTabPage Text="Overview">
                    <div class="pt-3"><PolicyOverview Policy="_policy" /></div>
                </DxTabPage>
                <DxTabPage Text="@($"Categories ({_policy.AppCategories.Count})")">
                    <div class="pt-3"><CategoriesEditor Policy="_policy" Changed="OnChanged" /></div>
                </DxTabPage>
                <DxTabPage Text="@($"Category policies ({_policy.CategoryPolicies.Count})")">
                    <div class="pt-3"><CategoryPoliciesEditor Policy="_policy" Changed="OnChanged" /></div>
                </DxTabPage>
                <DxTabPage Text="@($"Session rules ({_policy.SessionRules.Count})")">
                    <div class="pt-3"><SessionRulesEditor Policy="_policy" Changed="OnChanged" /></div>
                </DxTabPage>
                <DxTabPage Text="General">
                    <div class="pt-3" style="max-width:640px">
                        <h6>Total daily screen time</h6>
                        <DxCheckBox T="bool" CheckType="CheckType.Switch" Checked="_policy.DailyBudgetMinutes is not null"
                                    CheckedChanged="(bool v) => _policy.DailyBudgetMinutes = v ? (_policy.DailyBudgetMinutes ?? 240) : null">
                            Limit total screen time per day (all apps, across the child's devices)
                        </DxCheckBox>
                        @if (_policy.DailyBudgetMinutes is not null)
                        {
                            <div class="row g-2 mt-1 mb-2">
                                <div class="col-sm-6">
                                    <label class="form-label small mb-0">Budget (minutes)</label>
                                    <DxSpinEdit T="int?" @bind-Value="_policy.DailyBudgetMinutes" MinValue="0" MaxValue="1440" Increment="15" />
                                    <div class="small text-muted">@PolicyEditorHelpers.FormatMinutes(_policy.DailyBudgetMinutes)</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small mb-0">When exceeded</label>
                                    <select class="form-select form-select-sm" value="@_policy.DailyBudgetExceededAction"
                                            @onchange="e => _policy.DailyBudgetExceededAction = Enum.Parse<PolicyRuleAction>((string)e.Value!)">
                                        @foreach (var a in PolicyEditorHelpers.PowerActions) { <option value="@a">@PolicyEditorHelpers.ActionLabel(a)</option> }
                                    </select>
                                </div>
                            </div>
                        }

                        <h6 class="mt-3">Usage counting</h6>
                        <DxCheckBox T="bool" CheckType="CheckType.Switch" @bind-Checked="_policy.TrackUsage">Count usage time while this mode is active</DxCheckBox>
                        <div class="small text-muted">
                            Turn off for an unrestricted mode you use yourself (e.g. "Open"), so your time doesn't reduce the child's remaining budget
                            when you switch back. Note: anyone using the device while this is off is not counted.
                        </div>
                        @if (!_policy.TrackUsage && (_policy.DailyBudgetMinutes is not null || _policy.CategoryPolicies.Any(p => p.Enforcement == CategoryPolicyEnforcement.TimeLimited)))
                        {
                            <div class="alert alert-warning py-1 small mt-1">This mode has time budgets, but usage isn't counted – the budgets will only reflect time counted in other modes.</div>
                        }

                        <h6 class="mt-3">Day reset</h6>
                        <label class="form-label small mb-0">Day starts at hour (0–23, device local time)</label>
                        <DxSpinEdit T="int" @bind-Value="_policy.DayStartHour" MinValue="0" MaxValue="23" Width="120px" />
                        <div class="small text-muted mb-3">E.g. 6 = late-night use until 06:00 still counts towards the previous day.</div>

                        <h6>Monitoring</h6>
                        <div class="d-flex flex-column gap-2">
                            <DxCheckBox T="bool" CheckType="CheckType.Switch" @bind-Checked="_policy.EnableMonitoring">Enable monitoring</DxCheckBox>
                            <DxCheckBox T="bool" CheckType="CheckType.Switch" @bind-Checked="_policy.LogActivity">Log activity</DxCheckBox>
                            <div>
                                <label class="form-label small mb-0">Check interval (seconds)</label>
                                <DxSpinEdit T="int" @bind-Value="_policy.CheckIntervalSeconds" MinValue="1" MaxValue="300" Width="120px" />
                            </div>
                        </div>
                    </div>
                </DxTabPage>
                <DxTabPage Text="JSON">
                    <div class="pt-3">
                        <p class="small text-muted">
                            Advanced: this JSON always reflects the current editor state (including unsaved changes).
                            If you edit it here, press <strong>Apply to editor</strong> to take it over – nothing is saved until you press Save.
                        </p>
                        @if (_jsonEdited)
                        {
                            <div class="alert alert-warning py-1 small mb-2">JSON edited – not yet applied. The editor tabs still show the previous state.</div>
                        }
                        <DxMemo Text="@CurrentJson" TextChanged="OnJsonEdited" Rows="28" CssClass="pe-mono" />
                        @if (!string.IsNullOrEmpty(_jsonError))
                        {
                            <div class="text-danger small mt-1">@_jsonError</div>
                        }
                        <div class="mt-2 d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" disabled="@(!_jsonEdited)" @onclick="ApplyJson">Apply to editor</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_jsonEdited)" @onclick="RefreshJson"
                                    title="Discard JSON edits and read the current editor state">Read from editor</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyJsonAsync">Copy</button>
                        </div>
                    </div>
                </DxTabPage>
            </DxTabs>
        }
        else if (!_loading)
        {
            <div class="text-muted">Select a mode to edit.</div>
        }
    </div>
</div>

@code {
    private List<PolicyProfileDto> _profiles = new();
    private PolicyProfileDto? _selected;
    private PolicyConfiguration? _policy;
    private string _name = string.Empty;
    private string _snapshot = string.Empty;
    private string _snapshotName = string.Empty;
    private int _tabIndex;
    private string _json = string.Empty;
    private bool _jsonEdited;
    private string _jsonError = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _statusIsError;
    private bool _loading = true;
    private bool _saving;

    private bool IsDirty => _policy is not null && (PolicyEditorHelpers.Serialize(_policy) != _snapshot || _name != _snapshotName);

    protected override async Task OnInitializedAsync()
    {
        await LoadProfilesAsync(selectId: null);
        _loading = false;
    }

    private void Status(string message, bool error = false)
    {
        _statusMessage = message;
        _statusIsError = error;
    }

    private async Task LoadProfilesAsync(Guid? selectId)
    {
        try
        {
            _profiles = await PolicyApiService.GetProfilesAsync();
            var target = _profiles.FirstOrDefault(p => p.Id == selectId)
                         ?? _profiles.FirstOrDefault(p => p.IsActive)
                         ?? _profiles.FirstOrDefault();
            Edit(target);
        }
        catch (Exception ex)
        {
            Status($"Failed to load modes: {ex.Message}", true);
        }
    }

    private void Edit(PolicyProfileDto? profile)
    {
        _selected = profile;
        _policy = profile is null ? null : PolicyEditorHelpers.Clone(profile.Policy);
        _name = profile?.Name ?? string.Empty;
        _snapshot = _policy is null ? string.Empty : PolicyEditorHelpers.Serialize(_policy);
        _snapshotName = _name;
        RefreshJson();
    }

    private async Task<bool> ConfirmDiscardAsync() =>
        !IsDirty || await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Discard them?");

    private async Task SelectProfileAsync(PolicyProfileDto profile)
    {
        if (profile.Id == _selected?.Id || !await ConfirmDiscardAsync()) return;
        Edit(profile);
    }

    private void OnChanged() { /* Re-render recomputes dirty state and validation. */ }

    private void OnTabChanged(int index) => _tabIndex = index;

    /// <summary>Live editor state as JSON, unless the user has typed their own (unapplied) JSON.</summary>
    private string CurrentJson => _jsonEdited ? _json : _policy is null ? string.Empty : PolicyEditorHelpers.Serialize(_policy);

    private void OnJsonEdited(string text)
    {
        _json = text;
        _jsonEdited = true;
        _jsonError = string.Empty;
    }

    private void Revert() => Edit(_selected);

    private async Task SaveAsync()
    {
        if (_selected is null || _policy is null) return;
        _saving = true;
        try
        {
            var updated = await PolicyApiService.UpdateProfileAsync(_selected.Id, _name.Trim(), _policy);
            Status(_selected.IsActive ? $"\"{_name}\" saved and pushed to devices." : $"\"{_name}\" saved.");
            await LoadProfilesAsync(updated?.Id ?? _selected.Id);
        }
        catch (Exception ex)
        {
            Status($"Failed to save: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ActivateAsync()
    {
        if (_selected is null) return;
        if (IsDirty && !await JS.InvokeAsync<bool>("confirm", "Activate the last saved version of this mode? Unsaved changes are not included."))
        {
            return;
        }

        try
        {
            await PolicyApiService.ActivateProfileAsync(_selected.Id);
            Status($"\"{_selected.Name}\" is now the active mode.");
            var keep = IsDirty ? PolicyEditorHelpers.Clone(_policy!) : null;
            var keepName = _name;
            await LoadProfilesAsync(_selected.Id);
            if (keep is not null)
            {
                _policy = keep;
                _name = keepName;
            }
        }
        catch (Exception ex)
        {
            Status($"Failed to switch mode: {ex.Message}", true);
        }
    }

    private async Task NewProfileAsync()
    {
        if (!await ConfirmDiscardAsync()) return;
        // Start from the current categories so the new mode classifies apps the same way.
        var source = _selected?.Policy;
        var policy = new PolicyConfiguration
        {
            AppCategories = source is null ? new() : PolicyEditorHelpers.Clone(source).AppCategories,
            DayStartHour = source?.DayStartHour ?? 0
        };
        await CreateAsync(UniqueName("New mode"), policy);
    }

    private async Task DuplicateProfileAsync()
    {
        if (_selected is null || !await ConfirmDiscardAsync()) return;
        await CreateAsync(UniqueName($"{_selected.Name} copy"), PolicyEditorHelpers.Clone(_selected.Policy));
    }

    private async Task CreateAsync(string name, PolicyConfiguration policy)
    {
        try
        {
            var created = await PolicyApiService.CreateProfileAsync(name, policy);
            Status($"Created \"{name}\".");
            await LoadProfilesAsync(created?.Id);
        }
        catch (Exception ex)
        {
            Status($"Failed to create mode: {ex.Message}", true);
        }
    }

    private async Task DeleteProfileAsync()
    {
        if (_selected is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete mode \"{_selected.Name}\"? This cannot be undone.")) return;
        try
        {
            await PolicyApiService.DeleteProfileAsync(_selected.Id);
            Status($"Deleted \"{_selected.Name}\".");
            _selected = null;
            await LoadProfilesAsync(null);
        }
        catch (Exception ex)
        {
            Status($"Failed to delete mode: {ex.Message}", true);
        }
    }

    private string UniqueName(string baseName)
    {
        var name = baseName;
        for (var i = 2; _profiles.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)); i++) name = $"{baseName} {i}";
        return name;
    }

    private void RefreshJson()
    {
        _json = string.Empty;
        _jsonEdited = false;
        _jsonError = string.Empty;
    }

    private void ApplyJson()
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<PolicyConfiguration>(_json, PolicyJsonOptions.Default);
            if (parsed is null)
            {
                _jsonError = "JSON is empty.";
                return;
            }

            _policy = parsed;
            RefreshJson();
            Status("JSON applied to the editor – review and Save.");
        }
        catch (JsonException ex)
        {
            _jsonError = ex.Message;
        }
    }

    private async Task CopyJsonAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentJson);
        Status("JSON copied to clipboard.");
    }
}
