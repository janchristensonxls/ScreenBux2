<!--
  Template for appsettings.Production.json, patched at install time by Product.wxs via
  util:XmlFile (SERVERBASEURL -> /config/ServerBaseUrl, CHECKINTERVALMINUTES ->
  /config/CheckIntervalMinutes). NOTE: util:XmlFile only edits XML; ScreenBux.Updater actually
  reads JSON configuration (see Program.cs / appsettings.json elsewhere in the repo). This
  template is a placeholder illustrating the patch points - before wiring this installer into
  CI, either (a) switch to a WiX-authored ini/text-replacement custom action for JSON, or
  (b) have ScreenBux.Updater support an XML config source, or (c) generate this file with a
  small custom action (e.g. a C# or PowerShell immediate CA) that writes real JSON instead of
  relying on util:XmlFile. Tracked as a follow-up - see installer/README.md.
-->
{
  "ServerBaseUrl": "__SERVERBASEURL__",
  "CheckIntervalMinutes": 60,
  "Service": {
    "InstallDirectory": "__SERVICEINSTALLDIRECTORY__",
    "ExecutablePath": "__SERVICEEXECUTABLEPATH__",
    "InstalledVersionFile": "C:\\ProgramData\\ScreenBux\\service.version"
  },
  "Agent": {
    "InstallDirectory": "__AGENTINSTALLDIRECTORY__",
    "ExecutablePath": "__AGENTEXECUTABLEPATH__",
    "InstalledVersionFile": "C:\\ProgramData\\ScreenBux\\agent.version"
  }
}
