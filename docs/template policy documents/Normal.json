{
	"name": "Normal",
	"appCategories": [
		{
			"name": "Games",
			"rules": [
				{
					"processNameRegex": "discord|Steam|epic|battle|roblox|Forge|fort|AutoClicker|GeometryDash|xbox|medal|Kryptex|obs64|minecraft|Astroneer|subnautica",
					"windowTitleRegex": "roblox|Forge|fort|games|fun |brawl|minecraft|Palladium|Astroneer|spel|jeux|jouer|play gam|online|GeometryDash|Geometry Dash|xbox",
					"enabled": true
				}
			]
		},
		{
			"name": "Social-media",
			"rules": [
				{
					"processNameRegex": "Whatsapp|snapchat",
					"windowTitleRegex": "facebook|instagram|tiktok",
					"enabled": true
				}
			]
		},
		{
			"name": "Distraction",
			"rules": [
				{
					"processNameRegex": null,
					"windowTitleRegex": "manga|youtube|tiktok|anime|netflix|movies|series|films",
					"enabled": true
				}
			]
		},
		{
			"name": "Other",
			"rules": []
		}
	],
	"categoryPolicies": [
		{
			"categoryNames": [
				"Games",
				"Social-media",
				"Distraction"
			],
			"enforcement": "TimeLimited",
			"dailyBudgetMinutes": 120,
			"action": "CloseProcess",
			"allowedWindows": []
		}
	],
	"sessionRules": [
		{
			"name": "Bedtime Lockout week",
			"enabled": true,
			"action": "Sleep",
			"schedule": [
				{
					"daysOfWeek": [
						"Sunday",
						"Monday",
						"Tuesday",
						"Wednesday",
						"Thursday"
					],
					"startTime": "21:00:00",
					"endTime": "07:00:00"
				}
			]
		},
		{
			"name": "Bedtime Lockout week-end",
			"enabled": true,
			"action": "Sleep",
			"schedule": [
				{
					"daysOfWeek": [
						"Saturday",
						"Sunday"
					],
					"startTime": "01:00:00",
					"endTime": "09:00:00"
				}
			]
		}
